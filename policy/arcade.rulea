version 2
namespace arcade

schema:
    age: int
    trust: int
    chaos: int
    cart_total: int
    loyalty: int
    risk: int
    banned: bool
    night_owl: bool
    beta_tester: bool

rule hard_ban:
    when: banned
    effect: DENY
    reason: "BANフラグがあるため即時拒否"
    priority: 100
    tags: safety, deny

rule adult:
    when: age >= 18
    reason: "18歳以上"
    tags: identity

rule trusted:
    when: trust >= 65 and risk < 70
    reason: "信頼度65以上かつリスク70未満"
    tags: trust

rule beta_pass:
    when: beta_tester and trust >= 40
    reason: "βテスター特例"
    tags: beta

rule general_entry:
    when: matches("adult") and matches("trusted")
    reason: "通常入場条件を満たした"
    priority: 20
    tags: entry

rule beta_entry:
    when: matches("beta_pass") and age >= 16
    reason: "βテスター先行入場"
    priority: 10
    tags: entry, beta

ruleset entry:
    rules: hard_ban, general_entry, beta_entry
    strategy: deny_overrides
    default: DENY

rule vip:
    when: age >= 20 and trust >= 80 and loyalty >= 4 and risk < 45 and not banned
    reason: "VIP条件: 20歳以上・信頼80+・常連4+・低リスク"
    tags: vip, loyalty

rule coupon:
    when: cart_total >= 5000 and loyalty >= 3 and risk < 60 and not banned
    reason: "5,000円以上・常連3+・リスク60未満でクーポン解禁"
    tags: commerce, coupon

rule midnight:
    when: age >= 18 and night_owl and chaos <= 80 and trust >= 55 and not banned
    reason: "夜型・混沌度80以下・信頼55+で深夜活動を許可"
    tags: night, access
